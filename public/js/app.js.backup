/**
 * PM-SETU MEDIA MIX DIGITAL DOCUMENTATION & MONITORING SYSTEM
 * Application Controller & Interactive Logic
 * National Instructional Media Institute (NIMI)
 */

const App = {
  currentUser: null,
  currentSection: 'dashboard',
  selectedBidderCategory: 'dissemination',
  selectedBidderId: 'DIS-01',
  selectedTenderTab: 'dissemination',
  selectedMediaFilter: 'all',
  selectedDocCategoryFilter: 'all',
  
  // Initialize Application
  async init() {
    try {
      const res = await fetch('/api/me');
      if (!res.ok) {
        window.location.href = '/login.html';
        return;
      }
      const data = await res.json();
      this.currentUser = {
        id: data.id,
        name: data.username,
        roleName: data.role,
        designation: data.role,
        avatar: data.username.substring(0, 2).toUpperCase()
      };
      
      // Bind Event Listeners
      this.bindEvents();
      
      // Render current view
      this.updateUserProfile();
      this.navigate('dashboard');
      this.updateStats();
      
      // Log initial session
      this.logAudit("Portal Session Active", "User Session Initialized", "Logged In", "Active Session");
    } catch (err) {
      window.location.href = '/login.html';
    }
 }
  // Event Listeners
  bindEvents() {
    // Role switcher dropdown
    const roleSelect = document.getElementById('role-select');
    if (roleSelect) {
      roleSelect.addEventListener('change', (e) => {
        const selectedId = e.target.value;
        const user = window.PM_SETU_DATA.users.find(u => u.id === selectedId);
        if (user) {
          this.currentUser = user;
          this.updateUserProfile();
          this.showToast(`Switched active persona to ${user.name} (${user.roleName})`);
          this.logAudit("Role Persona Switch", `Switched to ${user.roleName}`, "Previous Role", user.roleName);
          // Re-render current section with updated permissions
          this.renderSection(this.currentSection);
        }
      });
    }

    // Navigation links in sidebar
    document.querySelectorAll('.sidebar-nav .nav-link').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const section = link.getAttribute('data-section');
        if (section) {
          this.navigate(section);
        }
      });
    });

    // Global Search Input
    const searchInput = document.getElementById('global-search');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.trim().toLowerCase();
        this.handleGlobalSearch(query);
      });
    }

    // Modal Close buttons
    document.querySelectorAll('.modal-close-btn, .btn-modal-close').forEach(btn => {
      btn.addEventListener('click', () => {
        this.closeAllModals();
      });
    });

    // Close modal on background click
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
          this.closeAllModals();
        }
      });
    });
  },

  // Update Top Profile Header
  updateUserProfile() {
    const user = this.currentUser;
    const nameEl = document.getElementById('user-name');
    const roleEl = document.getElementById('user-role');
    const avatarEl = document.getElementById('user-avatar');
    const roleSelect = document.getElementById('role-select');

    if (nameEl) nameEl.textContent = user.name;
    if (roleEl) roleEl.textContent = user.designation;
    if (avatarEl) avatarEl.textContent = user.avatar;
    if (roleSelect && roleSelect.value !== user.id) {
      roleSelect.value = user.id;
    }
  },

  // Navigation Router
  navigate(sectionId) {
    this.currentSection = sectionId;
    
    // Update active nav link
    document.querySelectorAll('.sidebar-nav .nav-link').forEach(link => {
      if (link.getAttribute('data-section') === sectionId) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    });

    // Update Breadcrumb
    const breadcrumbCurrent = document.getElementById('breadcrumb-current');
    if (breadcrumbCurrent) {
      breadcrumbCurrent.textContent = this.formatSectionTitle(sectionId);
    }

    // Render section contents
    this.renderSection(sectionId);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  },

  formatSectionTitle(sectionId) {
    const titles = {
      'dashboard': 'Executive Dashboard',
      'projects': 'Projects Master',
      'tenders': 'Tenders Master',
      'tecs': 'TEC Master',
      'contracts': 'Contracts Master',
      'documents': 'Document Repository',
      'monitoring': 'Monitoring & Video Links',
      'admin-approvals': '01. Administrative & Approvals',
      'rfp-tenders': '02. RFP & Tender Documents',
      'bidder-docs': '03. Bidder Documents & Isolation Boundary',
      'tec-evaluation': '05. Technical Evaluation Committee (TEC)',
      'financial-eval': '06. Financial Evaluation & Comparative Statement',
      'selection-approval': '07. Selection & Approval Workflow',
      'work-orders': '08. Work Order & Agreement (Executed Contracts)',
      'media-planning': '09. Media Planning & Buying Schedule',
      'creative-assets': '10. Creative & Campaign Assets Repository',
      'campaign-evidence': '11. Campaign Execution Evidence (Proof of Performance)',
      'bills-payment': '12. Bills & Payment Processing',
      'final-report': '13. Final Campaign Completion Report',
      'master-register': '14. Master Document Register (MDR)',
      'reports': '15. Reports & Analytical Dossiers',
      'user-access': '16. User & Role-Based Access Control (RBAC)',
      'audit-trail': '17. Non-Repudiable System Audit Trail',
      'archive': '18. Final Project Archive (PM-SETU 2026-27)',
      'system-overview': 'System Architecture & Database Specifications'
    };
    return titles[sectionId] || 'Document Repository';
  },

  // Render Sections
  renderSection(sectionId) {
    const mainContainer = document.getElementById('main-content');
    if (!mainContainer) return;

    switch(sectionId) {
      case 'dashboard':
        if (window.Phase6) window.Phase6.renderDashboard(mainContainer);
        break;
      case 'projects':
        if (window.Phase2) window.Phase2.renderProjectsList(mainContainer);
        break;
      case 'tenders':
        if (window.Phase2) window.Phase2.renderTendersList(mainContainer);
        break;
      case 'tecs':
        if (window.Phase3) window.Phase3.renderTecsList(mainContainer);
        break;
      case 'contracts':
        if (window.Phase3) window.Phase3.renderContractsList(mainContainer);
        break;
      case 'documents':
        if (window.Phase4) window.Phase4.renderDocumentsList(mainContainer);
        break;
      case 'monitoring':
        if (window.Phase5) window.Phase5.renderMonitoringList(mainContainer);
        break;
      case 'admin-approvals':
        this.renderAdminApprovals(mainContainer);
        break;
      case 'rfp-tenders':
        this.renderRfpTenders(mainContainer);
        break;
      case 'bidder-docs':
        this.renderBidderDocs(mainContainer);
        break;
      case 'tec-evaluation':
        this.renderTecEvaluation(mainContainer);
        break;
      case 'financial-eval':
        this.renderFinancialEval(mainContainer);
        break;
      case 'selection-approval':
        this.renderSelectionApproval(mainContainer);
        break;
      case 'work-orders':
        this.renderWorkOrders(mainContainer);
        break;
      case 'media-planning':
        this.renderMediaPlanning(mainContainer);
        break;
      case 'creative-assets':
        this.renderCreativeAssets(mainContainer);
        break;
      case 'campaign-evidence':
        this.renderCampaignEvidence(mainContainer);
        break;
      case 'bills-payment':
        this.renderBillsPayment(mainContainer);
        break;
      case 'final-report':
        this.renderFinalReport(mainContainer);
        break;
      case 'master-register':
        this.renderMasterRegister(mainContainer);
        break;
      case 'reports':
        if (window.Phase7) window.Phase7.renderReportsCatalog(mainContainer);
        break;
      case 'user-access':
        this.renderUserAccess(mainContainer);
        break;
      case 'audit-trail':
        if (window.Phase8) window.Phase8.renderAuditViewer(mainContainer);
        break;
      case 'archive':
        this.renderArchive(mainContainer);
        break;
      case 'system-overview':
        this.renderSystemOverview(mainContainer);
        break;
      default:
        this.renderDashboard(mainContainer);
    }
  },

  // Compute and Update Dashboard Statistics
  updateStats() {
    const docs = window.PM_SETU_DATA.documents;
    const media = window.PM_SETU_DATA.mediaPlan;
    const assets = window.PM_SETU_DATA.creativeAssets;
    const evidence = window.PM_SETU_DATA.evidenceItems;
    const invoices = window.PM_SETU_DATA.invoices;

    const countAdmin = docs.filter(d => d.category.includes('Administrative')).length;
    const countTender = docs.filter(d => d.category.includes('RFP & Tender')).length;
    const countBidder = docs.filter(d => d.category.includes('Bidder Documents')).length;
    const countTec = docs.filter(d => d.category.includes('Technical Evaluation')).length;
    const countApproved = docs.filter(d => d.status === 'Approved').length;
    const countPending = docs.filter(d => d.status === 'Under Review' || d.status === 'Under Verification' || d.status === 'Draft').length;
    const countArchive = docs.filter(d => d.status === 'Archived').length;

    // Update stat card DOM elements if present
    const elMap = {
      'stat-total-docs': docs.length,
      'stat-admin-docs': countAdmin,
      'stat-tender-docs': countTender,
      'stat-bidder-docs': countBidder,
      'stat-tec-docs': countTec,
      'stat-approved-docs': countApproved,
      'stat-media-plans': media.length,
      'stat-creative-assets': assets.length,
      'stat-evidence-docs': evidence.length,
      'stat-bills-docs': invoices.length,
      'stat-pending-docs': countPending,
      'stat-archived-docs': countArchive
    };

    for (const [id, val] of Object.entries(elMap)) {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    }
  },

