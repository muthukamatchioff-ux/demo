  // Document Detail Modal View
  viewDocument(docId) {
    const doc = window.PM_SETU_DATA.documents.find(d => d.id === docId);
    if (!doc) return;

    const modalBody = document.getElementById('preview-modal-body');
    const modalTitle = document.getElementById('preview-modal-title');
    modalTitle.textContent = `${doc.name} (${doc.id})`;

    modalBody.innerHTML = `
      <div style="background:#f8fafc; border:1px solid var(--border-medium); border-radius:6px; padding:16px; margin-bottom:16px;">
        <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
          <div><strong>Document ID:</strong> <code>${doc.id}</code></div>
          <div><strong>Version:</strong> <span class="badge badge-info">${doc.version}</span> (${doc.versionLabel || 'Working'})</div>
        </div>
        <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
          <div><strong>Category:</strong> ${doc.category}</div>
          <div><strong>Subcategory:</strong> ${doc.subcategory || 'N/A'}</div>
        </div>
        <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
          <div><strong>Author / Source:</strong> ${doc.agency}</div>
          <div><strong>Owner:</strong> ${doc.owner}</div>
        </div>
        <div style="display:flex; justify-content:space-between;">
          <div><strong>Date:</strong> ${doc.date}</div>
          <div><strong>Status:</strong> <span class="badge ${doc.status === 'Approved' ? 'badge-success' : 'badge-warning'}">${doc.status}</span></div>
        </div>
      </div>

      <div style="margin-bottom:16px;">
        <h4 style="font-size:13px; font-weight:700; color:#0b2545; margin-bottom:4px;">Official Remarks & Summary</h4>
        <p style="font-size:12.5px; color:#475569; line-height:1.5;">${doc.remarks || 'Official institutional record.'}</p>
      </div>

      <div style="margin-bottom:16px;">
        <h4 style="font-size:13px; font-weight:700; color:#0b2545; margin-bottom:6px;">Version Lineage & Change Description</h4>
        <div style="background:#ffffff; border:1px solid var(--border-light); border-radius:4px; padding:10px; font-size:12px;">
          ${doc.history ? doc.history.map(h => `
            <div style="padding:4px 0; border-bottom:1px dashed #e2e8f0;">
              <strong>${h.version}</strong> (${h.date}) by <em>${h.user}</em> &bull; ${h.note}
            </div>
          `).join('') : 'Initial sealed version.'}
        </div>
      </div>

      ${doc.hasRealFile ? `
        <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:6px; padding:14px; display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
          <div>
            <strong style="color:#1e40af;">Actual File in Local Workspace:</strong>
            <div style="font-size:12px; color:#1e3a8a;">${doc.realPath}</div>
          </div>
          <a href="${doc.realPath}" target="_blank" class="btn btn-primary btn-sm">
            📄 Open Local Document
          </a>
        </div>
      ` : ''}

      <div style="text-align:right; border-top:1px solid var(--border-medium); padding-top:14px;">
        <button class="btn btn-primary btn-sm" onclick="App.openEditModal('${doc.id}')">
          ✏️ Edit Document Metadata & Manage Versions
        </button>
      </div>
    `;

    document.getElementById('preview-modal').classList.add('active');
    this.logAudit("Document Viewed", `Inspected document metadata ${doc.id}`, "Stored", "Inspected");
  },

  // Open Document Upload Modal
  openUploadModal(defaultCategory = '', defaultAgency = '') {
    // Check permission
    if (this.currentUser.role === 'bidder_competitor') {
      alert("Permission Denied: Your account role does not possess upload privileges.");
      return;
    }

    const catSelect = document.getElementById('upload-category');
    if (catSelect && defaultCategory) {
      catSelect.value = defaultCategory;
    }
    const agencyInput = document.getElementById('upload-agency');
    if (agencyInput && defaultAgency) {
      agencyInput.value = defaultAgency;
    }

    document.getElementById('upload-modal').classList.add('active');
  },

  // Handle Document Upload Submit
  handleUploadSubmit(e) {
    e.preventDefault();
    const title = document.getElementById('upload-title').value.trim();
    const category = document.getElementById('upload-category').value;
    const version = document.getElementById('upload-version').value;
    const remarks = document.getElementById('upload-remarks').value.trim();
    const access = document.getElementById('upload-access').value;

    if (!title) {
      alert("Please specify the document title.");
      return;
    }

    // Generate unique ID based on category
    let prefix = "PMM-DOC-";
    if (category.includes("Administrative")) prefix = "PMM-ADM-";
    else if (category.includes("RFP")) prefix = "PMM-RFP-";
    else if (category.includes("Bidder")) prefix = "PMM-BID-";
    else if (category.includes("Technical")) prefix = "PMM-TEC-";
    else if (category.includes("Financial")) prefix = "PMM-FIN-";
    else if (category.includes("Work Order")) prefix = "PMM-WO-";
    else if (category.includes("Media")) prefix = "PMM-MED-";
    else if (category.includes("Creative")) prefix = "PMM-CRE-";
    else if (category.includes("Evidence")) prefix = "PMM-EVD-";
    else if (category.includes("Bills")) prefix = "PMM-PAY-";

    const newId = `${prefix}${String(window.PM_SETU_DATA.documents.length + 1).padStart(3, '0')}`;
    const newDoc = {
      id: newId,
      category: category,
      subcategory: category.split('.')[1]?.trim() || category,
      name: title,
      agency: this.currentUser.department || "NIMI / MSDE",
      date: new Date().toISOString().split('T')[0],
      version: version,
      versionLabel: version.includes('2') ? "Approved Version" : "Working Draft",
      owner: this.currentUser.name,
      status: "Under Review",
      accessLevel: access,
      location: `${category}/${title.replace(/[^a-zA-Z0-9]/g, '_')}_${version}.pdf`,
      size: "1.2 MB",
      remarks: remarks || "Uploaded via Portal Interface.",
      history: [
        { version: version, date: new Date().toISOString().split('T')[0], user: this.currentUser.name, note: "Initial upload." }
      ]
    };

    window.PM_SETU_DATA.documents.unshift(newDoc);
    this.closeAllModals();
    this.showToast(`Document ${newId} registered successfully!`);
    this.logAudit("Document Uploaded", `Registered document ${newId} (${title})`, "Draft", "Under Review");
    this.updateStats();
    this.renderSection(this.currentSection);
  },

  // Open Document Edit & Version Upgrade Modal
  openEditModal(docId) {
    const user = this.currentUser;
    const doc = window.PM_SETU_DATA.documents.find(d => d.id === docId);
    if (!doc) {
      alert("Document not found in repository.");
      return;
    }

    // Role-based permission check
    if (user.role === 'bidder_competitor') {
      alert("Permission Denied: Your account role does not possess document editing privileges.");
      return;
    }

    if (user.role.includes('agency') && doc.bidderId !== user.agencyId) {
      alert("Access Denied: You may only modify deliverables submitted by your assigned agency.");
      return;
    }

    // Populate modal fields
    document.getElementById('edit-doc-id').value = doc.id;
    document.getElementById('edit-doc-id-badge').textContent = doc.id;
    document.getElementById('edit-current-version-badge').textContent = `${doc.version} (${doc.status})`;
    document.getElementById('edit-title').value = doc.name;
    document.getElementById('edit-category').value = doc.category;
    document.getElementById('edit-status').value = doc.status;
    document.getElementById('edit-access').value = doc.accessLevel;
    document.getElementById('edit-change-note').value = "";
    document.getElementById('edit-remarks').value = doc.remarks || "";
    document.getElementById('edit-version-action').value = "keep";

    document.getElementById('edit-modal').classList.add('active');
  },

  // Handle Document Edit Submit
  handleEditSubmit(e) {
    e.preventDefault();
    const docId = document.getElementById('edit-doc-id').value;
    const doc = window.PM_SETU_DATA.documents.find(d => d.id === docId);
    if (!doc) return;

    const newTitle = document.getElementById('edit-title').value.trim();
    const newCategory = document.getElementById('edit-category').value;
    const newStatus = document.getElementById('edit-status').value;
    const newAccess = document.getElementById('edit-access').value;
    const versionAction = document.getElementById('edit-version-action').value;
    const changeNote = document.getElementById('edit-change-note').value.trim();
    const newRemarks = document.getElementById('edit-remarks').value.trim();
    const fileInput = document.getElementById('edit-file');

    if (!changeNote) {
      alert("Please provide a Change Description / Revision Note explaining this modification.");
      return;
    }

    const previousStatus = doc.status;
    const previousVersion = doc.version;
    let newVersion = previousVersion;

    // Handle Version Increment per Section 14
    if (versionAction === 'minor') {
      const match = doc.version.match(/v(\d+)\.(\d+)/);
      if (match) {
        const major = parseInt(match[1]);
        const minor = parseInt(match[2]) + 1;
        newVersion = `v${major}.${minor}`;
      } else {
        newVersion = "v1.1";
      }
      doc.versionLabel = "Working Draft";
    } else if (versionAction === 'major') {
      const match = doc.version.match(/v(\d+)/);
      const major = match ? parseInt(match[1]) + 1 : 2;
      newVersion = `v${major}.0`;
      doc.versionLabel = "Approved Version";
    }

    // Apply updates
    doc.name = newTitle;
    doc.category = newCategory;
    doc.subcategory = newCategory.split('.')[1]?.trim() || newCategory;
    doc.status = newStatus;
    doc.accessLevel = newAccess;
    doc.version = newVersion;
    doc.remarks = newRemarks;

    // Update location if file attached
    if (fileInput && fileInput.files && fileInput.files.length > 0) {
      doc.location = `${newCategory}/${fileInput.files[0].name}`;
      doc.size = `${(fileInput.files[0].size / 1024 / 1024).toFixed(2)} MB`;
    }

    // Append to version history lineage
    if (!doc.history) doc.history = [];
    doc.history.unshift({
      version: newVersion,
      date: new Date().toISOString().split('T')[0],
      user: this.currentUser.name,
      note: changeNote
    });

    this.closeAllModals();
    this.showToast(`Document ${doc.id} successfully updated to ${newVersion} (${newStatus})`);
    this.logAudit("Document Edited", `Updated ${doc.id} (${changeNote})`, `${previousStatus} [${previousVersion}]`, `${newStatus} [${newVersion}]`);
    this.updateStats();
    this.renderSection(this.currentSection);
  },

  // Interactive TEC Scoring Modal
  openTecScoringModal() {
    const modalBody = document.getElementById('preview-modal-body');
    const modalTitle = document.getElementById('preview-modal-title');
    modalTitle.textContent = "Technical Evaluation Committee (TEC) - Score Entry";

    modalBody.innerHTML = `
      <form id="tec-scoring-form" onsubmit="App.handleTecScoringSubmit(event)">
        <div class="form-group">
          <label class="form-label">Select Tender</label>
          <select class="form-control" id="score-tender-select" onchange="App.populateScoreBidders(this.value)">
            <option value="tender1">Dissemination Agency (01/2026-27/PM SETU Media Campaign/NIMI)</option>
            <option value="tender2">Creative Agency (02/2026-27/PM SETU Media Campaign/NIMI)</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Select Bidder</label>
          <select class="form-control" id="score-bidder-select">
            <option value="M/s Action for Rural Development">M/s Action for Rural Development</option>
            <option value="M/s Bharat Communications Ltd">M/s Bharat Communications Ltd</option>
            <option value="M/s Prasar Outreach Consortium">M/s Prasar Outreach Consortium</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Evaluator Identity</label>
          <input type="text" class="form-control" value="${this.currentUser.name} (${this.currentUser.designation})" readonly>
        </div>
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
          <div class="form-group">
            <label class="form-label">Technical Proposal Marks (Max: 70)</label>
            <input type="number" class="form-control" id="score-tech" min="0" max="70" step="0.5" value="62.5" required>
          </div>
          <div class="form-group">
            <label class="form-label">Presentation Marks (Max: 30)</label>
            <input type="number" class="form-control" id="score-pres" min="0" max="30" step="0.5" value="26.0" required>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Evaluator Observations / Justification</label>
          <textarea class="form-control" id="score-remarks" placeholder="Provide detailed technical rationale...">Strong regional capabilities and CBC compliance.</textarea>
        </div>
        <div style="text-align:right; margin-top:16px;">
          <button type="submit" class="btn btn-primary">Submit Official TEC Score</button>
        </div>
      </form>
    `;

    document.getElementById('preview-modal').classList.add('active');
  },

  populateScoreBidders(tenderKey) {
    const select = document.getElementById('score-bidder-select');
    if (!select) return;
    if (tenderKey === 'tender1') {
      select.innerHTML = `
        <option value="M/s Action for Rural Development">M/s Action for Rural Development</option>
        <option value="M/s Bharat Communications Ltd">M/s Bharat Communications Ltd</option>
        <option value="M/s Prasar Outreach Consortium">M/s Prasar Outreach Consortium</option>
      `;
    } else {
      select.innerHTML = `
        <option value="M/s Super Ads Creative Media Pvt. Ltd.">M/s Super Ads Creative Media Pvt. Ltd.</option>
        <option value="M/s Drishti Creative Studio LLP">M/s Drishti Creative Studio LLP</option>
        <option value="M/s Varta Multimedia & Brand Lab">M/s Varta Multimedia & Brand Lab</option>
      `;
    }
  },

  handleTecScoringSubmit(e) {
    e.preventDefault();
    const bidder = document.getElementById('score-bidder-select').value;
    const tech = parseFloat(document.getElementById('score-tech').value) || 0;
    const pres = parseFloat(document.getElementById('score-pres').value) || 0;
    const total = tech + pres;

    this.closeAllModals();
    this.showToast(`TEC Score for ${bidder} recorded: ${total} / 100 Marks`);
    this.logAudit("TEC Score Entry", `Recorded score ${total}/100 for ${bidder}`, "Under Evaluation", "Score Tabulated");
    if (this.currentSection === 'tec-evaluation') {
      this.renderTecEvaluation(document.getElementById('main-content'));
    }
  },

  // Interactive Workflow Approval Modal
  openWorkflowApprovalModal() {
    const modalBody = document.getElementById('preview-modal-body');
    const modalTitle = document.getElementById('preview-modal-title');
    modalTitle.textContent = "Record Workflow Stage Approval";

    modalBody.innerHTML = `
      <form onsubmit="App.handleWorkflowSubmit(event)">
        <div class="form-group">
          <label class="form-label">Workflow Milestone Stage</label>
          <select class="form-control" id="wf-stage">
            <option value="Stage 4: Competent Authority Approval">Stage 4: Competent Authority Approval</option>
            <option value="Stage 5: Agency Selection & LoI">Stage 5: Agency Selection & LoI</option>
            <option value="Stage 6: Work Order Execution">Stage 6: Work Order Execution</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Signing Authority</label>
          <input type="text" class="form-control" value="${this.currentUser.name} (${this.currentUser.designation})" readonly>
        </div>
        <div class="form-group">
          <label class="form-label">Official Sanction Reference Number</label>
          <input type="text" class="form-control" id="wf-ref" value="MSDE-F.No.18011/04/2026-Media" required>
        </div>
        <div class="form-group">
          <label class="form-label">Official Approval Note / Orders</label>
          <textarea class="form-control" id="wf-remarks" required>Approved as recommended by the Technical Evaluation Committee.</textarea>
        </div>
        <div style="text-align:right; margin-top:16px;">
          <button type="submit" class="btn btn-success">Record Official Approval</button>
        </div>
      </form>
    `;

    document.getElementById('preview-modal').classList.add('active');
  },

  handleWorkflowSubmit(e) {
    e.preventDefault();
    const stage = document.getElementById('wf-stage').value;
    const ref = document.getElementById('wf-ref').value;

    this.closeAllModals();
    this.showToast(`Approval successfully logged for ${stage}`);
    this.logAudit("Workflow Approved", `Approved ${stage} (Ref: ${ref})`, "Submitted", "Approved");
    if (this.currentSection === 'selection-approval') {
      this.renderSelectionApproval(document.getElementById('main-content'));
    }
  },

  // Close Modals
  closeAllModals() {
    document.querySelectorAll('.modal-overlay').forEach(m => m.classList.remove('active'));
  },

  // Toast Notification
  showToast(message) {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.innerHTML = `<span>🛡️</span><span>${message}</span>`;
    container.appendChild(toast);
    setTimeout(() => {
      toast.style.opacity = '0';
      setTimeout(() => toast.remove(), 300);
    }, 3500);
  },

  // Append Audit Log
  logAudit(action, entity, prevStatus, newStatus) {
    const logs = window.PM_SETU_DATA.auditLogs;
    const newLog = {
      id: `AUD-${1000 + logs.length + 1}`,
      timestamp: new Date().toLocaleString('en-IN') + ' IST',
      user: this.currentUser.name,
      role: this.currentUser.roleName,
      action: action,
      entity: entity,
      previousStatus: prevStatus,
      newStatus: newStatus,
      ip: "10.14.20.105 (NIMI Campus Network)",
      hash: Math.random().toString(36).substring(2, 12)
    };
    logs.unshift(newLog);
  },

  // Global Search
  handleGlobalSearch(query) {
    if (!query || query.length < 2) return;
    const docs = window.PM_SETU_DATA.documents;
    const matches = docs.filter(d => 
      d.id.toLowerCase().includes(query) ||
      d.name.toLowerCase().includes(query) ||
      d.category.toLowerCase().includes(query) ||
      d.agency.toLowerCase().includes(query) ||
      d.owner.toLowerCase().includes(query) ||
      (d.remarks && d.remarks.toLowerCase().includes(query))
    );

    if (this.currentSection !== 'master-register') {
      this.navigate('master-register');
    }

    // Render search results directly into the table
    const tableBody = document.querySelector('.data-table tbody');
    if (tableBody) {
      if (matches.length === 0) {
        tableBody.innerHTML = `<tr><td colspan="9" style="text-align:center; padding:24px; color:#64748b;">No documents matching "${query}" found.</td></tr>`;
      } else {
        tableBody.innerHTML = matches.map(d => `
          <tr style="background:#fefce8;">
            <td><code>${d.id}</code></td>
            <td><small>${d.category}</small></td>
            <td><strong>${d.name}</strong><br><small style="color:#64748b;">${d.location}</small></td>
            <td>${d.agency}</td>
            <td>${d.date}</td>
            <td><span class="badge badge-info">${d.version}</span></td>
            <td><span class="badge ${d.status === 'Approved' ? 'badge-success' : 'badge-warning'}">${d.status}</span></td>
            <td><span class="badge badge-outline">${d.accessLevel}</span></td>
            <td>
              <button class="btn btn-secondary btn-sm" onclick="App.viewDocument('${d.id}')">View</button>
              ${d.hasRealFile ? `<a href="${d.realPath}" target="_blank" class="btn btn-primary btn-sm">Open File</a>` : ''}
            </td>
          </tr>
        `).join('');
      }
    }
  }
};

// Bootstrap application on DOM ready
document.addEventListener('DOMContentLoaded', () => {
  App.init();
});

if (typeof window !== "undefined") {
  window.App = App;
}
