      { key: "evidence-report", title: "Proof of Performance (PoP) Audit", desc: "Verification logs of published tear sheets and broadcast logs." },
      { key: "payment-report", title: "Invoices & Payment Sanctions", desc: "Milestone bill clearances, GST verification and PFMS UTR tracking." },
