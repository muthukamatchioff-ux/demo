      <!-- Quick Document Access Table -->
      <div class="table-card">
        <div class="table-toolbar">
          <div class="table-title">
            <h3>Recent Signed & Approved Official Documents</h3>
            <p>Directly linked to executed PDF and Word agreements in the workspace</p>
          </div>
          <button class="btn btn-secondary btn-sm" onclick="App.navigate('master-register')">
            Open Full Master Document Register &rarr;
          </button>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Document ID</th>
              <th>Category</th>
              <th>Document Name</th>
              <th>Agency / Source</th>
              <th>Date</th>
              <th>Version</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            ${docs.slice(0, 7).map(d => `
              <tr>
                <td><code>${d.id}</code></td>
                <td><small>${d.category}</small></td>
                <td>
                  <strong>${d.name}</strong><br>
                  <small style="color:#64748b;">${d.location}</small>
                </td>
                <td>${d.agency}</td>
                <td>${d.date}</td>
                <td><span class="badge badge-info">${d.version}</span></td>
                <td><span class="badge ${d.status === 'Approved' ? 'badge-success' : 'badge-warning'}">${d.status}</span></td>
                <td>
                  <button class="btn btn-secondary btn-sm" onclick="App.viewDocument('${d.id}')">
                    👁️ View Details
                  </button>
                  <button class="btn btn-secondary btn-sm" onclick="App.openEditModal('${d.id}')" style="margin-left:4px;">
                    ✏️ Edit
                  </button>
                  ${d.hasRealFile ? `
                    <a href="${d.realPath}" target="_blank" class="btn btn-primary btn-sm" style="margin-left:4px;">
                      📄 Open File
                    </a>
                  ` : ''}
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  },

  // 2. ADMINISTRATIVE & APPROVALS
  renderAdminApprovals(container) {
    const docs = window.PM_SETU_DATA.documents.filter(d => d.category.includes('Administrative'));
    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
          <h2>01. Administrative & Approvals</h2>
          <p>File Notes, Administrative Approvals, Committee Constitutions, Official Correspondence, and Meeting Minutes.</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-primary btn-sm" onclick="App.openUploadModal('01. Administrative & Approvals')">
            + Upload Administrative Doc
          </button>
        </div>
      </div>

      <div class="table-card">
        <div class="table-toolbar">
          <div class="table-title">
            <h3>Administrative Repository & Sanctions</h3>
            <p>Total Records: ${docs.length}</p>
          </div>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Doc ID</th>
              <th>Subcategory</th>
              <th>Document Title</th>
              <th>Authority / Owner</th>
              <th>Date</th>
              <th>Version</th>
              <th>Access</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            ${docs.map(d => `
              <tr>
                <td><code>${d.id}</code></td>
                <td><span class="badge badge-outline">${d.subcategory}</span></td>
                <td>
                  <strong>${d.name}</strong><br>
                  <small style="color:#64748b;">${d.remarks}</small>
                </td>
                <td>${d.owner}</td>
                <td>${d.date}</td>
                <td><span class="badge badge-info">${d.version}</span></td>
                <td><span class="badge badge-secondary">${d.accessLevel}</span></td>
                <td>
                  <button class="btn btn-secondary btn-sm" onclick="App.viewDocument('${d.id}')">View</button>
                  <button class="btn btn-secondary btn-sm" onclick="App.openEditModal('${d.id}')" style="margin-left:4px;">✏️ Edit</button>
                  ${d.hasRealFile ? `<a href="${d.realPath}" target="_blank" class="btn btn-primary btn-sm" style="margin-left:4px;">Open File</a>` : ''}
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  },

  // 3. RFP & TENDER DOCUMENTS
  renderRfpTenders(container) {
    const tenders = window.PM_SETU_DATA.projectInfo.tenders;
    const rfpDocs = window.PM_SETU_DATA.documents.filter(d => d.category.includes('RFP'));

    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
          <h2>02. RFP & Tender Documents</h2>
          <p>Central Public Procurement Portal (CPPP) records, RFPs, Corrigenda, Pre-Bid Notices and Technical Specifications.</p>
        </div>
      </div>

      <div class="tabs-header">
        <button class="tab-btn ${this.selectedTenderTab === 'dissemination' ? 'active' : ''}" onclick="App.switchTenderTab('dissemination')">
          Dissemination Agency Tender (01/2026-27)
        </button>
        <button class="tab-btn ${this.selectedTenderTab === 'creative' ? 'active' : ''}" onclick="App.switchTenderTab('creative')">
          Creative Agency Tender (02/2026-27)
        </button>
      </div>

      <div class="table-card">
        <div class="table-toolbar">
          <div class="table-title">
            <h3>Tender Specification & Public Notices</h3>
            <p>Published on CPPP Portal under Single-Stage System</p>
          </div>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Doc ID</th>
              <th>Category</th>
              <th>Document Title</th>
              <th>Date</th>
              <th>Version</th>
              <th>Access</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            ${rfpDocs.filter(d => {
              if (this.selectedTenderTab === 'dissemination') return d.subcategory.includes('Dissemination');
              return d.subcategory.includes('Creative');
            }).map(d => `
              <tr>
                <td><code>${d.id}</code></td>
                <td><span class="badge badge-outline">${d.subcategory}</span></td>
                <td>
                  <strong>${d.name}</strong><br>
                  <small style="color:#64748b;">${d.remarks}</small>
                </td>
                <td>${d.date}</td>
                <td><span class="badge badge-info">${d.version}</span></td>
                <td><span class="badge badge-success">${d.accessLevel}</span></td>
                <td>
                  <button class="btn btn-secondary btn-sm" onclick="App.viewDocument('${d.id}')">View Details</button>
                  <button class="btn btn-secondary btn-sm" onclick="App.openEditModal('${d.id}')" style="margin-left:4px;">✏️ Edit</button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  },

  switchTenderTab(tab) {
    this.selectedTenderTab = tab;
    this.renderRfpTenders(document.getElementById('main-content'));
  },

  // 4. BIDDER DOCUMENTS (STRICT BIDDER ISOLATION BOUNDARY)
  renderBidderDocs(container) {
    const bidders = window.PM_SETU_DATA.bidders;
    const user = this.currentUser;

    // Security check: Check if current user is an Agency User from a competing agency
    const isRestrictedAgency = user.role.includes('agency') || user.role.includes('bidder');
    let authorizedAgencyId = user.agencyId || null;

    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
          <h2>03. Bidder Documents Repository</h2>
          <p>Confidential spaces for participating bidders. Technical Bids, CBC Empanelment, Experience, and Presentations.</p>
        </div>
      </div>

      <!-- Security Warning Banner (Section 16 Requirement) -->
      <div class="security-alert-box">
        <div style="font-size:20px;">🛡️</div>
        <div>
          <strong>Confidential Government Procurement Record – Authorised Access Only.</strong><br>
          Under Rule 173 of General Financial Rules (GFR) 2017 and CVC Public Procurement Guidelines, one bidder is strictly prohibited from accessing competitor bids, proprietary rates, or internal technical evaluation notes.
        </div>
      </div>

      <div style="display:grid; grid-template-columns: 280px 1fr; gap: 20px;">
        <!-- Left: Bidder Selection List -->
        <div class="table-card">
          <div class="table-toolbar">
            <h4 style="font-size:13px; font-weight:700; color:#0b2545;">Select Bidder Dossier</h4>
          </div>
          <div style="padding: 12px;">
            <div style="font-size:11px; font-weight:700; color:#64748b; text-transform:uppercase; margin-bottom:8px;">Dissemination Agency Bidders</div>
            ${bidders.filter(b => b.category.includes('Dissemination')).map(b => `
              <div onclick="App.selectBidder('${b.id}')" style="padding:10px 12px; margin-bottom:6px; border-radius:4px; cursor:pointer; border:1px solid ${this.selectedBidderId === b.id ? 'var(--gov-blue)' : 'var(--border-medium)'}; background:${this.selectedBidderId === b.id ? '#eff6ff' : '#ffffff'};">
                <div style="font-weight:700; font-size:12.5px; color:#0b2545;">${b.name}</div>
                <div style="font-size:11px; color:#64748b;">Score: ${b.technicalScore || 'Ineligible'} &bull; ${b.status}</div>
              </div>
            `).join('')}

            <div style="font-size:11px; font-weight:700; color:#64748b; text-transform:uppercase; margin:14px 0 8px 0;">Creative Agency Bidders</div>
            ${bidders.filter(b => b.category.includes('Creative')).map(b => `
              <div onclick="App.selectBidder('${b.id}')" style="padding:10px 12px; margin-bottom:6px; border-radius:4px; cursor:pointer; border:1px solid ${this.selectedBidderId === b.id ? 'var(--gov-blue)' : 'var(--border-medium)'}; background:${this.selectedBidderId === b.id ? '#eff6ff' : '#ffffff'};">
                <div style="font-weight:700; font-size:12.5px; color:#0b2545;">${b.name}</div>
                <div style="font-size:11px; color:#64748b;">Score: ${b.technicalScore || 'N/A'} &bull; ${b.status}</div>
              </div>
            `).join('')}
          </div>
        </div>

        <!-- Right: Bidder Documents Display or Isolation Block -->
        <div>
          ${this.renderBidderDetailArea(isRestrictedAgency, authorizedAgencyId)}
        </div>
      </div>
    `;
  },

  selectBidder(bidderId) {
    this.selectedBidderId = bidderId;
    this.renderBidderDocs(document.getElementById('main-content'));
  },

  renderBidderDetailArea(isRestrictedAgency, authorizedAgencyId) {
    const bidder = window.PM_SETU_DATA.bidders.find(b => b.id === this.selectedBidderId);
    if (!bidder) return `<p>Bidder not found.</p>`;

    // ISOLATION BOUNDARY ENFORCEMENT:
    // If the logged in user is an agency user and tries to view ANOTHER bidder:
    if (isRestrictedAgency && authorizedAgencyId !== bidder.id) {
      return `
        <div class="table-card" style="padding: 40px 24px; text-align: center; border: 2px dashed #fca5a5; background:#fff1f2;">
          <div style="font-size: 48px; margin-bottom: 12px;">🚫</div>
          <h3 style="color: #991b1b; font-size: 18px; font-weight: 800; margin-bottom: 8px;">
            ACCESS DENIED - BIDDER ISOLATION BOUNDARY ENFORCED
          </h3>
          <p style="color: #7f1d1d; max-width: 600px; margin: 0 auto 16px auto; font-size: 13px;">
            You are logged in as <strong>${this.currentUser.name}</strong> (${this.currentUser.roleName}).
            Your security privileges restrict you strictly to your own agency's documentation. You do NOT have permission to view confidential bids or proposals submitted by <strong>${bidder.name}</strong>.
          </p>
          <div style="font-size: 12px; color: #991b1b; font-family: monospace;">
            Security Incident Reference: POL-GFR-173-ISOLATION-VIOLATION-BLOCKED
          </div>
          <div style="margin-top:20px;">
            <button class="btn btn-secondary btn-sm" onclick="App.selectBidder('${authorizedAgencyId}')">
              Switch Back to My Assigned Bidder Space (${authorizedAgencyId})
            </button>
          </div>
        </div>
      `;
    }

    // If authorized, show bidder dossier
    const bidderDocs = window.PM_SETU_DATA.documents.filter(d => d.bidderId === bidder.id);

    return `
      <div class="table-card">
        <div class="table-toolbar">
          <div>
            <h3>${bidder.name}</h3>
            <p>Location: ${bidder.location} &bull; Tender: ${bidder.tenderId} &bull; Status: <span class="badge ${bidder.status.includes('Selected') ? 'badge-success' : 'badge-secondary'}">${bidder.status}</span></p>
          </div>
          <button class="btn btn-primary btn-sm" onclick="App.openUploadModal('03. Bidder Documents', '${bidder.name}')">
            + Upload Bidder Submission
          </button>
        </div>

        <div style="padding: 16px 20px; background: #f8fafc; border-bottom: 1px solid var(--border-medium); display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; font-size: 12px;">
          <div><strong>CBC Empanelment:</strong><br>${bidder.cbcEmpaneled}</div>
          <div><strong>Avg 3-Yr Turnover:</strong><br>${bidder.turnoverAvg}</div>
          <div><strong>Technical Score:</strong><br><span style="font-weight:700; color:#0b2545;">${bidder.technicalScore ? bidder.technicalScore + ' / 100' : 'Ineligible'}</span></div>
          <div><strong>Folder Location:</strong><br><code>${bidder.folderPath}</code></div>
        </div>

        <table class="data-table">
          <thead>
            <tr>
              <th>Doc ID</th>
              <th>Document Description</th>
              <th>Date</th>
              <th>Version</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            ${bidderDocs.length ? bidderDocs.map(d => `
              <tr>
                <td><code>${d.id}</code></td>
                <td>
                  <strong>${d.name}</strong><br>
                  <small style="color:#64748b;">${d.remarks}</small>
                </td>
                <td>${d.date}</td>
                <td><span class="badge badge-info">${d.version}</span></td>
                <td><span class="badge badge-success">${d.status}</span></td>
                <td>
                  <button class="btn btn-secondary btn-sm" onclick="App.viewDocument('${d.id}')">View Dossier</button>
                  <button class="btn btn-secondary btn-sm" onclick="App.openEditModal('${d.id}')" style="margin-left:4px;">✏️ Edit</button>
                </td>
              </tr>
            `).join('') : `
              <tr>
                <td colspan="6" style="text-align:center; padding: 24px; color:#64748b;">
                  Standard CPPP encrypted bid documents archived in electronic vault.
                </td>
              </tr>
            `}
          </tbody>
        </table>
      </div>
    `;
  },

  // 5. TECHNICAL EVALUATION COMMITTEE (TEC) MODULE
  renderTecEvaluation(container) {
    const tec = window.PM_SETU_DATA.tecData;
    const user = this.currentUser;
    const canScore = user.role === 'admin' || user.role === 'tec_member';

    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
          <h2>05. Technical Evaluation Committee (TEC) Workspace</h2>
          <p>Eligibility Scrutiny, Technical Evaluation Checklist, Score Sheets, Presentation Schedule and Minutes.</p>
        </div>
        <div class="page-actions">
          ${canScore ? `
            <button class="btn btn-primary btn-sm" onclick="App.openTecScoringModal()">
              ✍️ Enter / Update TEC Scores
            </button>
          ` : ''}
          <button class="btn btn-secondary btn-sm" onclick="ReportEngine.generateReport('tec-report')">
            🖨️ Export TEC Consolidated Report
          </button>
        </div>
      </div>

      <!-- Real files notice -->
      <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:6px; padding:12px 16px; margin-bottom:20px; display:flex; align-items:center; justify-content:space-between;">
        <div>
          <strong style="color:#1e40af;">Official Signed Evaluation Records Available in Workspace:</strong>
          <div style="font-size:12px; color:#1e3a8a;">
            &bull; Minutes of meeting and Annexure 2 of Dissemination AGencies PM-SETU.pdf<br>
            &bull; Creative Agncy/3. PM-SETU_Creative_Agency_Individual_Score_Sheets_Including_Average_Presentation_Marks_Unsigned.pdf.pdf
          </div>
        </div>
        <a href="Minutes of meeting and Annexure 2 of Dissemination AGencies PM-SETU.pdf" target="_blank" class="btn btn-primary btn-sm">
          📄 Open Dissemination TEC Minutes PDF
        </a>
      </div>

      <!-- Dissemination TEC Table -->
      <div class="table-card">
        <div class="table-toolbar">
          <div class="table-title">
            <h3>Dissemination Agency - Consolidated Technical Scores</h3>
            <p>Tender: 01/2026-27/PM SETU Media Campaign/NIMI &bull; Cutoff: 70/100 Marks</p>
          </div>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Bidder Name</th>
              <th>Scrutiny Status</th>
              <th>Presentation Attendance</th>
              <th>MSDE Score</th>
              <th>DGT Score</th>
              <th>NIMI Score</th>
              <th>CBC Score</th>
              <th>Average Score</th>
              <th>Ranking</th>
              <th>Recommendation</th>
            </tr>
          </thead>
          <tbody>
            ${tec.tender1.biddersEvaluation.map(b => `
              <tr style="${b.rank.includes('H-1') ? 'background:#f0fdf4;' : ''}">
                <td><strong>${b.bidderName}</strong></td>
                <td><span class="badge badge-success">${b.scrutinyStatus}</span></td>
                <td><small>${b.presentationAttendance}</small></td>
                <td>${b.evaluatorScores[0].score}</td>
                <td>${b.evaluatorScores[1].score}</td>
                <td>${b.evaluatorScores[2].score}</td>
                <td>${b.evaluatorScores[3].score}</td>
                <td><strong style="color:#0b2545; font-size:14px;">${b.averageScore}</strong></td>
                <td><span class="badge ${b.rank.includes('H-1') ? 'badge-success' : 'badge-secondary'}">${b.rank}</span></td>
                <td><small>${b.recommendation}</small></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>

      <!-- Creative Agency TEC Table -->
      <div class="table-card">
        <div class="table-toolbar">
          <div class="table-title">
            <h3>Creative Agency - Consolidated Technical Scores</h3>
            <p>Tender: 02/2026-27/PM SETU Media Campaign/NIMI &bull; Cutoff: 70/100 Marks</p>
          </div>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Bidder Name</th>
              <th>Scrutiny Status</th>
              <th>Presentation Attendance</th>
              <th>Director MSDE</th>
              <th>Director DGT</th>
              <th>Executive Director NIMI</th>
              <th>Average Score</th>
              <th>Ranking</th>
              <th>Recommendation</th>
            </tr>
          </thead>
          <tbody>
            ${tec.tender2.biddersEvaluation.map(b => `
              <tr style="${b.rank.includes('H-1') ? 'background:#f0fdf4;' : ''}">
                <td><strong>${b.bidderName}</strong></td>
                <td><span class="badge badge-success">${b.scrutinyStatus}</span></td>
                <td><small>${b.presentationAttendance}</small></td>
                <td>${b.evaluatorScores[0].score}</td>
                <td>${b.evaluatorScores[1].score}</td>
                <td>${b.evaluatorScores[2].score}</td>
                <td><strong style="color:#0b2545; font-size:14px;">${b.averageScore}</strong></td>
                <td><span class="badge ${b.rank.includes('H-1') ? 'badge-success' : 'badge-secondary'}">${b.rank}</span></td>
                <td><small>${b.recommendation}</small></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  },

  // 6. FINANCIAL EVALUATION MODULE
  renderFinancialEval(container) {
    const user = this.currentUser;
    // Security check: Only Admin, Senior Officer, or Project Team can see financial comparison
    const hasFinancialAccess = ['admin', 'senior_officer', 'project_team'].includes(user.role);

    if (!hasFinancialAccess) {
      container.innerHTML = `
        <div class="page-header">
          <div class="page-header-text">
            <h2>06. Financial Evaluation Module</h2>
            <p>Confidential Financial Comparison & Vetting</p>
          </div>
        </div>
        <div class="table-card" style="padding: 40px 24px; text-align: center; border: 2px dashed #fca5a5; background:#fff1f2;">
          <div style="font-size: 48px; margin-bottom: 12px;">🔒</div>
          <h3 style="color: #991b1b; font-size: 18px; font-weight: 800; margin-bottom: 8px;">
            RESTRICTED ACCESS - CONFIDENTIAL FINANCIAL BID INFORMATION
          </h3>
          <p style="color: #7f1d1d; max-width: 600px; margin: 0 auto; font-size: 13px;">
            Your active role <strong>${user.roleName}</strong> does not possess clearance to inspect commercial price schedules or comparative financial statements. Access is strictly limited to authorized Finance and Tender Evaluation Authorities.
          </p>
        </div>
      `;
      return;
    }

    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
          <h2>06. Financial Evaluation Module</h2>
          <p>Comparative Statement, Financial Bids, Applicable GST (18%), and Budget Cap Verification.</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-secondary btn-sm" onclick="ReportEngine.generateReport('payment-report')">
            📑 Financial Vetting Report
          </button>
        </div>
      </div>

      <div class="table-card">
        <div class="table-toolbar">
          <div class="table-title">
            <h3>Dissemination Agency - Financial Comparative Statement</h3>
            <p>Approved Outlay Cap: ₹ 23,50,00,000/- (Inclusive of 18% GST)</p>
          </div>
          <span class="badge badge-success">Vetted & Conformed</span>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Bidder Name</th>
              <th>Technical Score (St)</th>
              <th>Base Financial Proposal</th>
              <th>GST @ 18%</th>
              <th>Total Evaluated Price</th>
              <th>Conformity to Cap</th>
              <th>Outcome</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>M/s Action for Rural Development</strong></td>
              <td>88.5 / 100 (H-1)</td>
              <td>₹ 19,91,52,542/-</td>
              <td>₹ 3,58,47,458/-</td>
              <td><strong>₹ 23,50,00,000/-</strong></td>
              <td><span class="badge badge-success">100% Within Cap</span></td>
              <td><span class="badge badge-success">Selected Agency (H-1)</span></td>
            </tr>
            <tr>
              <td><strong>M/s Bharat Communications Ltd</strong></td>
              <td>76.2 / 100 (H-2)</td>
              <td>₹ 19,91,52,542/-</td>
              <td>₹ 3,58,47,458/-</td>
              <td>₹ 23,50,00,000/-</td>
              <td><span class="badge badge-success">Within Cap</span></td>
              <td><span class="badge badge-secondary">Non-Selected</span></td>
            </tr>
            <tr>
              <td><strong>M/s Prasar Outreach Consortium</strong></td>
              <td>71.0 / 100 (H-3)</td>
              <td>₹ 19,91,52,542/-</td>
              <td>₹ 3,58,47,458/-</td>
              <td>₹ 23,50,00,000/-</td>
              <td><span class="badge badge-success">Within Cap</span></td>
              <td><span class="badge badge-secondary">Non-Selected</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="table-card">
        <div class="table-toolbar">
