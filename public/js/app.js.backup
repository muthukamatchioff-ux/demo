  // 9. MEDIA PLANNING & BUYING
  renderMediaPlanning(container) {
    const items = window.PM_SETU_DATA.mediaPlan;
    const filtered = this.selectedMediaFilter === 'all' ? items : items.filter(i => i.media.toLowerCase().includes(this.selectedMediaFilter));

    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
          <h2>09. Media Planning & Buying Schedule</h2>
          <p>Approved Media Mix, Platforms, Regions, Rates, and Proof of Performance Tracking.</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-secondary btn-sm" onclick="ReportEngine.generateReport('media-plan-report')">
            🖨️ Export Master Media Plan (PDF / CSV)
          </button>
        </div>
      </div>

      <div class="table-card">
        <div class="table-toolbar">
          <div class="table-title">
            <h3>Channel-Wise Media Plan Inventory</h3>
            <p>Total Scheduled Value: ₹ 23.50 Crores</p>
          </div>
          <div class="table-filters">
            <label class="form-label" style="margin:0; font-size:12px;">Filter Channel:</label>
            <select class="filter-select" onchange="App.filterMedia(this.value)">
              <option value="all" ${this.selectedMediaFilter==='all'?'selected':''}>All Media Channels</option>
              <option value="tv" ${this.selectedMediaFilter==='tv'?'selected':''}>TV Broadcast</option>
              <option value="radio" ${this.selectedMediaFilter==='radio'?'selected':''}>Radio</option>
              <option value="print" ${this.selectedMediaFilter==='print'?'selected':''}>Print Daily</option>
              <option value="digital" ${this.selectedMediaFilter==='digital'?'selected':''}>Digital & Social</option>
              <option value="outdoor" ${this.selectedMediaFilter==='outdoor'?'selected':''}>Outdoor / OOH</option>
              <option value="ott" ${this.selectedMediaFilter==='ott'?'selected':''}>OTT & Cinema</option>
            </select>
          </div>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Media</th>
              <th>Platform / Publication</th>
              <th>Market / Region</th>
              <th>Specs / Duration</th>
              <th>Volume</th>
              <th>Base Rate</th>
              <th>GST (18%)</th>
              <th>Total Outlay</th>
              <th>Status</th>
              <th>Proof Status</th>
            </tr>
          </thead>
          <tbody>
            ${filtered.map(m => `
              <tr>
                <td><strong>${m.media}</strong></td>
                <td>${m.platform}</td>
                <td><small>${m.marketRegion}</small></td>
                <td>${m.durationSize}</td>
                <td>${m.quantity}</td>
                <td>₹ ${(m.rate/100000).toFixed(2)} L</td>
                <td>₹ ${(m.gst/100000).toFixed(2)} L</td>
                <td><strong style="color:#0b2545;">₹ ${(m.total/100000).toFixed(2)} L</strong></td>
                <td><span class="badge badge-success">${m.status}</span></td>
                <td><span class="badge badge-info">${m.proofStatus}</span></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  },

  filterMedia(filter) {
    this.selectedMediaFilter = filter;
    this.renderMediaPlanning(document.getElementById('main-content'));
  },

  // 10. CREATIVE & CAMPAIGN ASSETS
  renderCreativeAssets(container) {
    const assets = window.PM_SETU_DATA.creativeAssets;
    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
          <h2>10. Creative & Campaign Assets Repository</h2>
          <p>Brand Guidelines, Master Video TVCs, Radio Jingles, Print Creatives, and 22-Language Adaptations.</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-primary btn-sm" onclick="App.openUploadModal('10. Creative & Campaign Assets')">
            + Upload Creative Asset
          </button>
        </div>
      </div>

      <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;">
        ${assets.map(a => `
          <div class="table-card" style="margin-bottom:0;">
            <div style="height: 120px; background: linear-gradient(135deg, #0b2545, #1e3a8a); color:#fff; display:flex; align-items:center; justify-content:center; flex-direction:column; padding:16px; text-align:center;">
              <div style="font-size:28px;">${a.previewType === 'video' ? '🎬' : a.previewType === 'audio' ? '🎵' : '🖼️'}</div>
              <div style="font-weight:700; font-size:13px; margin-top:4px;">${a.mediaType}</div>
              <div style="font-size:11px; color:#cbd5e1;">${a.language}</div>
            </div>
            <div style="padding:16px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                <code>${a.id}</code>
                <span class="badge badge-success">${a.version}</span>
              </div>
              <h4 style="font-size:14px; font-weight:700; color:#0b2545; margin-bottom:6px;">${a.title}</h4>
              <p style="font-size:12px; color:#64748b; margin-bottom:12px; line-height:1.4;">${a.remarks}</p>
              <div style="font-size:11.5px; color:#475569; border-top:1px solid var(--border-light); padding-top:10px; display:flex; justify-content:space-between;">
                <span>Size: ${a.fileSize}</span>
                <span>Format: ${a.format}</span>
              </div>
              <div style="margin-top:12px; display:flex; gap:8px;">
                <button class="btn btn-secondary btn-sm" style="flex:1;" onclick="App.previewAsset('${a.id}')">
                  👁️ Preview Asset
                </button>
                <button class="btn btn-primary btn-sm" style="flex:1;" onclick="App.showToast('Asset package downloaded: ${a.id}')">
                  ⬇️ Download
                </button>
              </div>
            </div>
          </div>
        `).join('')}
      </div>
    `;
  },

  previewAsset(assetId) {
    const asset = window.PM_SETU_DATA.creativeAssets.find(a => a.id === assetId);
    if (!asset) return;

    const modalBody = document.getElementById('preview-modal-body');
    const modalTitle = document.getElementById('preview-modal-title');
    modalTitle.textContent = `${asset.title} (${asset.id})`;

    modalBody.innerHTML = `
      <div style="text-align:center; padding: 20px; background:#0f172a; border-radius:6px; color:#fff; margin-bottom:16px;">
        <div style="font-size:48px; margin-bottom:12px;">${asset.previewType==='video'?'🎬':asset.previewType==='audio'?'🎵':'🖼️'}</div>
        <h4>${asset.title}</h4>
        <div style="font-size:12px; color:#94a3b8; margin-top:4px;">Language: ${asset.language} &bull; Format: ${asset.format} &bull; Size: ${asset.fileSize}</div>
        <div style="margin-top:16px;">
          <span class="badge badge-success">${asset.approvalStatus}</span>
        </div>
      </div>
      <div style="font-size:13px; line-height:1.5;">
        <p><strong>Campaign Phase:</strong> ${asset.campaign}</p>
        <p><strong>Uploaded By:</strong> ${asset.uploadedBy} on ${asset.date}</p>
        <p><strong>Technical Notes:</strong> ${asset.remarks}</p>
        <p><strong>IPR Assignment:</strong> Executed Deed of Assignment transferred to National Instructional Media Institute / Ministry of Skill Development.</p>
      </div>
    `;

    document.getElementById('preview-modal').classList.add('active');
    this.logAudit("Asset Previewed", `Previewed asset ${asset.id}`, "Stored", "Viewed");
  },

  // 11. CAMPAIGN EXECUTION EVIDENCE (PROOF OF PERFORMANCE)
  renderCampaignEvidence(container) {
    const evidence = window.PM_SETU_DATA.evidenceItems;
    const canVerify = ['admin', 'project_team'].includes(this.currentUser.role);

    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
          <h2>11. Campaign Execution Evidence (Proof of Performance)</h2>
          <p>Tear Sheets, Telecast Certificates, Radio Logs, Geo-Tagged Billboards, and Digital Analytics Reports.</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-secondary btn-sm" onclick="ReportEngine.generateReport('evidence-report')">
            🖨️ Export Evidence Verification Audit
          </button>
        </div>
      </div>

      <div class="table-card">
        <div class="table-toolbar">
          <div class="table-title">
            <h3>Submitted Proof of Performance Dossiers</h3>
            <p>Verification is mandatory prior to invoice release</p>
          </div>
          <button class="btn btn-primary btn-sm" onclick="App.openUploadModal('11. Campaign Execution Evidence')">
            + Upload Evidence Dossier
          </button>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Evidence ID</th>
              <th>Media</th>
              <th>Evidence Title</th>
              <th>Date & Location</th>
              <th>Submitted By</th>
              <th>Status</th>
              <th>Verified By</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            ${evidence.map(e => `
              <tr>
                <td><code>${e.id}</code></td>
                <td><strong>${e.media}</strong></td>
                <td>
                  <strong>${e.title}</strong><br>
                  <small style="color:#64748b;">${e.remarks}</small>
                </td>
                <td>${e.date}<br><small>${e.location}</small></td>
                <td>${e.agency}</td>
                <td><span class="badge ${e.verificationStatus === 'Verified' ? 'badge-success' : 'badge-warning'}">${e.verificationStatus}</span></td>
                <td>${e.verifiedBy}</td>
                <td>
                  ${canVerify && e.verificationStatus !== 'Verified' ? `
                    <button class="btn btn-success btn-sm" onclick="App.verifyEvidence('${e.id}')">
                      ✓ Verify
                    </button>
                  ` : `
                    <button class="btn btn-secondary btn-sm" onclick="App.showToast('Inspected evidence file: ${e.file}')">
                      👁️ Inspect
                    </button>
                  `}
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  },

  verifyEvidence(id) {
    const item = window.PM_SETU_DATA.evidenceItems.find(e => e.id === id);
    if (item) {
      item.verificationStatus = 'Verified';
      item.verifiedBy = `${this.currentUser.name} (${this.currentUser.designation})`;
      item.verificationDate = new Date().toLocaleString('en-IN') + ' IST';
      this.showToast(`Evidence ${id} has been officially verified!`);
      this.logAudit("Evidence Verified", `Verified PoP for ${id}`, "Submitted", "Verified");
      this.renderCampaignEvidence(document.getElementById('main-content'));
    }
  },

  // 12. BILLS & PAYMENT MODULE
  renderBillsPayment(container) {
    const invoices = window.PM_SETU_DATA.invoices;
    const canApprove = ['admin', 'senior_officer'].includes(this.currentUser.role);

    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
          <h2>12. Bills & Payment Processing</h2>
          <p>Invoice Register, GST Compliance, Sanction Orders, PFMS Disbursements, and UTR Tracking.</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-secondary btn-sm" onclick="ReportEngine.generateReport('payment-report')">
            🖨️ Payment Status Report
          </button>
        </div>
      </div>

      <div class="table-card">
        <div class="table-toolbar">
          <div class="table-title">
            <h3>Commercial Invoices & Milestone Disbursements</h3>
            <p>Linked to verified Proof of Performance & Bank Guarantees</p>
          </div>
          <button class="btn btn-primary btn-sm" onclick="App.openUploadModal('12. Bills & Payment')">
            + Submit Agency Invoice
          </button>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Invoice No.</th>
              <th>Agency</th>
              <th>Billing Milestone</th>
              <th>Base (₹)</th>
              <th>GST 18% (₹)</th>
              <th>Gross Total (₹)</th>
              <th>Sanction Order</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            ${invoices.map(i => `
              <tr>
                <td><strong>${i.invoiceNo}</strong><br><small>Dated: ${i.submittedDate}</small></td>
                <td>${i.agency}</td>
                <td>${i.period}</td>
                <td>₹ ${i.amountExclTax.toLocaleString('en-IN')}</td>
                <td>₹ ${i.gstAmount.toLocaleString('en-IN')}</td>
                <td><strong style="color:#0b2545;">₹ ${i.totalAmount.toLocaleString('en-IN')}</strong></td>
                <td><code>${i.sanctionRef}</code></td>
                <td><span class="badge ${i.paymentStatus.includes('Paid') ? 'badge-success' : 'badge-info'}">${i.paymentStatus}</span></td>
                <td>
                  ${canApprove && i.paymentStatus !== 'Paid' ? `
                    <button class="btn btn-success btn-sm" onclick="App.markInvoicePaid('${i.invoiceNo}')">
                      Approve & Pay
                    </button>
                  ` : `
                    <button class="btn btn-secondary btn-sm" onclick="App.showToast('Viewing invoice ${i.invoiceNo}')">
                      👁️ Details
                    </button>
                  `}
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  },

  markInvoicePaid(invoiceNo) {
    const inv = window.PM_SETU_DATA.invoices.find(i => i.invoiceNo === invoiceNo);
    if (inv) {
      inv.paymentStatus = 'Paid (PFMS Disbursed)';
      inv.utrRef = `PFMS-TXN-2026-${Math.floor(100000 + Math.random() * 900000)}`;
      this.showToast(`Invoice ${invoiceNo} marked as Paid. UTR: ${inv.utrRef}`);
      this.logAudit("Payment Disbursed", `Disbursed payment for ${invoiceNo}`, "Approved", "Paid");
      this.renderBillsPayment(document.getElementById('main-content'));
    }
  },

  // 13. FINAL CAMPAIGN REPORT
  renderFinalReport(container) {
    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
          <h2>13. Final Campaign Completion Report</h2>
          <p>National Reach Metrics, ITI Footfall, SLA Adherence, and Executive Project Sign-Off.</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-primary btn-sm" onclick="ReportEngine.generateReport('complete-register')">
            🖨️ Print Final Campaign Dossier
          </button>
        </div>
      </div>

      <div class="table-card" style="padding: 24px;">
        <div style="text-align:center; max-width:800px; margin: 0 auto 30px auto;">
          <h3 style="color:#0b2545; font-size:18px; margin-bottom:8px;">
            PM-SETU ADVOCACY CAMPAIGN 2026-27: EXECUTIVE PERFORMANCE SUMMARY
          </h3>
          <p style="color:#64748b; font-size:13px;">
            A flagship national initiative to modernise 1,000 ITIs and 5 NSTIs into aspirational, government-owned, industry-managed technical training hubs.
          </p>
        </div>

        <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
          <div style="background:#f8fafc; border:1px solid var(--border-medium); border-radius:6px; padding:16px; text-align:center;">
            <div style="font-size:24px; font-weight:800; color:#0b2545;">185+ Million</div>
            <div style="font-size:12px; color:#64748b; text-transform:uppercase;">Gross Multi-Media Reach</div>
          </div>
          <div style="background:#f8fafc; border:1px solid var(--border-medium); border-radius:6px; padding:16px; text-align:center;">
            <div style="font-size:24px; font-weight:800; color:#15803d;">1,000 ITIs</div>
            <div style="font-size:12px; color:#64748b; text-transform:uppercase;">Ground Activation Covered</div>
          </div>
          <div style="background:#f8fafc; border:1px solid var(--border-medium); border-radius:6px; padding:16px; text-align:center;">
            <div style="font-size:24px; font-weight:800; color:#c25e00;">22 Languages</div>
            <div style="font-size:12px; color:#64748b; text-transform:uppercase;">Multilingual Content</div>
          </div>
          <div style="background:#f8fafc; border:1px solid var(--border-medium); border-radius:6px; padding:16px; text-align:center;">
            <div style="font-size:24px; font-weight:800; color:#1d4ed8;">98.4%</div>
            <div style="font-size:12px; color:#64748b; text-transform:uppercase;">SLA Adherence Score</div>
          </div>
        </div>
      </div>
    `;
  },

  // 14. MASTER DOCUMENT REGISTER (MDR)
  renderMasterRegister(container) {
    const docs = window.PM_SETU_DATA.documents;
    const filtered = this.selectedDocCategoryFilter === 'all' ? docs : docs.filter(d => d.category.includes(this.selectedDocCategoryFilter));

    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
          <h2>14. Master Document Register (MDR)</h2>
          <p>Universal inventory of all official digital records, standard document identifiers, and version stamps.</p>
        </div>
        <div class="page-actions">
          <button class="btn btn-primary btn-sm" onclick="App.openUploadModal()">
            + Register New Document
          </button>
          <button class="btn btn-secondary btn-sm" onclick="ReportEngine.generateReport('complete-register')">
            🖨️ Export MDR (PDF / Excel)
          </button>
        </div>
      </div>

      <div class="table-card">
        <div class="table-toolbar">
          <div class="table-title">
            <h3>Central Master Repository</h3>
            <p>Showing ${filtered.length} of ${docs.length} tracked records</p>
          </div>
          <div class="table-filters">
            <select class="filter-select" onchange="App.filterMdrCategory(this.value)">
              <option value="all">All Document Categories</option>
              <option value="Administrative">01. Administrative & Approvals</option>
              <option value="RFP">02. RFP & Tender Documents</option>
              <option value="Bidder">03. Bidder Documents</option>
              <option value="Technical Evaluation">05. Technical Evaluation (TEC)</option>
              <option value="Financial">06. Financial Evaluation</option>
              <option value="Work Order">08. Work Order & Agreement</option>
              <option value="Media Planning">09. Media Planning & Buying</option>
              <option value="Creative">10. Creative & Campaign Assets</option>
              <option value="Evidence">11. Campaign Execution Evidence</option>
              <option value="Bills">12. Bills & Payment</option>
              <option value="Archive">18. Archive</option>
            </select>
          </div>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Document ID</th>
              <th>Category</th>
              <th>Document Name</th>
              <th>Agency / Source</th>
              <th>Date</th>
              <th>Version</th>
              <th>Status</th>
              <th>Access Level</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            ${filtered.map(d => `
              <tr>
                <td><code>${d.id}</code></td>
                <td><small>${d.subcategory || d.category}</small></td>
                <td>
                  <strong>${d.name}</strong><br>
                  <small style="color:#64748b;">${d.location}</small>
                </td>
                <td>${d.agency}</td>
                <td>${d.date}</td>
                <td><span class="badge badge-info">${d.version}</span></td>
                <td><span class="badge ${d.status === 'Approved' ? 'badge-success' : 'badge-warning'}">${d.status}</span></td>
                <td><span class="badge badge-outline">${d.accessLevel}</span></td>
                <td>
                  <button class="btn btn-secondary btn-sm" onclick="App.viewDocument('${d.id}')">View</button>
                  <button class="btn btn-secondary btn-sm" onclick="App.openEditModal('${d.id}')" style="margin-left:4px;">✏️ Edit</button>
                  ${d.hasRealFile ? `<a href="${d.realPath}" target="_blank" class="btn btn-primary btn-sm" style="margin-left:4px;">Open File</a>` : ''}
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  },

  filterMdrCategory(cat) {
    this.selectedDocCategoryFilter = cat;
    this.renderMasterRegister(document.getElementById('main-content'));
  },

