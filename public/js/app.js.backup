  // 7. SELECTION & APPROVAL WORKFLOW
  renderSelectionApproval(container) {
    const pipeline = window.PM_SETU_DATA.selectionWorkflow;
    const canApprove = ['admin', 'senior_officer'].includes(this.currentUser.role);

    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
          <h2>07. Selection & Approval Workflow Tracking</h2>
          <p>Linear multi-stage verification from Technical Evaluation to Work Order Execution.</p>
        </div>
        <div class="page-actions">
          ${canApprove ? `
            <button class="btn btn-primary btn-sm" onclick="App.openWorkflowApprovalModal()">
              ✍️ Record Approval Action
            </button>
          ` : ''}
        </div>
      </div>

      <div class="table-card">
        <div class="table-toolbar">
          <div class="table-title">
            <h3>Sequential Procurement Milestone Matrix</h3>
            <p>Every transition is authenticated with electronic file references and digital audit entries.</p>
          </div>
        </div>
        <table class="data-table">
