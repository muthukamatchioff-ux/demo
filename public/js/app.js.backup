  simulateLoginAs(userId) {
    const user = window.PM_SETU_DATA.users.find(u => u.id === userId);
    if (user) {
      this.currentUser = user;
      this.updateUserProfile();
      this.showToast(`Switched active persona to ${user.name}`);
      this.renderUserAccess(document.getElementById('main-content'));
    }
  },

