                <td>${s.officer}</td>
                <td><code>${s.reference}</code></td>
                <td><span class="badge badge-success">${s.status}</span></td>
                <td><small>${s.remarks}</small></td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  },

  // 8. WORK ORDER & AGREEMENT
  renderWorkOrders(container) {
    container.innerHTML = `
      <div class="page-header">
        <div class="page-header-text">
