# Application Configuration
NODE_ENV=production
PORT=8080

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:REPLACE_WITH_SECURE_PASSWORD@db:5432/pmsetu?schema=public

# Docker Compose DB Variables
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DB_NAME=pmsetu

# Security configuration
# Must be a long, cryptographically secure random string
AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_STRING
