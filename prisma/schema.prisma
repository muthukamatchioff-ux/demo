datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


// =========================================================
// PHASE 1: USERS / ROLES / PERMISSIONS
// =========================================================

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  AuditLog          AuditLog[]
  projectsCreated   Project[]          @relation("ProjectCreatedBy")
  projectsUpdated   Project[]          @relation("ProjectUpdatedBy")
  tendersCreated    Tender[]           @relation("TenderCreatedBy")
  tendersUpdated    Tender[]           @relation("TenderUpdatedBy")
  tecsCreated       Tec[]              @relation("TecCreatedBy")
  tecsUpdated       Tec[]              @relation("TecUpdatedBy")
  contractsCreated  Contract[]         @relation("ContractCreatedBy")
  contractsUpdated  Contract[]         @relation("ContractUpdatedBy")
  docsCreated       Document[]         @relation("DocumentCreatedBy")
  docsUpdated       Document[]         @relation("DocumentUpdatedBy")
  docVersCreated    DocumentVersion[]  @relation("DocVersionCreatedBy")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(uuid())
  action          String
  module          String
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model FinancialYear {
  id        String   @id @default(uuid())
  year      String   @unique
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  action    String
  module    String
  recordId  String?
  details   String?
  ipAddress String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// =========================================================
// PHASE 2: PROJECTS & TENDERS
// =========================================================

model Project {
  id                 String   @id @default(uuid())
  projectCode        String   @unique
  projectName        String
  description        String?
  projectType        String?
  projectCategory    String?
  department         String?
  division           String?
  officeUnit         String?
  responsibleOfficer String?

  state        String?
  district     String?
  block        String?
  village      String?
  siteLocation String?

  estimatedCost   Float?
  sanctionedAmount Float?
  budgetHead      String?
  fundingSource   String?

  financialYearId String?
  financialYear   FinancialYear? @relation(
    fields: [financialYearId],
    references: [id]
  )

  startDate          DateTime?
  expectedCompletion DateTime?
  actualCompletion   DateTime?

  status    String    @default("Draft")
  remarks   String?
  deletedAt DateTime?

  createdById String?
  createdBy   User? @relation(
    "ProjectCreatedBy",
    fields: [createdById],
    references: [id]
  )

  updatedById String?
  updatedBy   User? @relation(
    "ProjectUpdatedBy",
    fields: [updatedById],
    references: [id]
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenders    Tender[]
  tecs       Tec[]
  contracts  Contract[]
  documents  Document[]
  monitoring Monitoring[]
  auditLogs  AuditLog[]

  @@index([projectCode])
  @@index([status])
  @@index([financialYearId])
}

model Tender {
  id                String   @id @default(uuid())
  tenderNumber      String   @unique
  tenderTitle       String
  description       String?
  tenderType        String?
  procurementMethod String?
  tenderCategory    String?

  estimatedValue Float?
  tenderFee      Float?
  emdAmount      Float?

  publishDate        DateTime?
  submissionStartDate DateTime?
  submissionEndDate   DateTime?
  bidOpeningDate     DateTime?

  status    String    @default("Draft")
  remarks   String?
  deletedAt DateTime?

  projectId String
  project   Project @relation(
    fields: [projectId],
    references: [id]
  )

  createdById String?
  createdBy   User? @relation(
    "TenderCreatedBy",
    fields: [createdById],
    references: [id]
  )

  updatedById String?
  updatedBy   User? @relation(
    "TenderUpdatedBy",
    fields: [updatedById],
    references: [id]
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tecs       Tec[]
  contracts  Contract[]
  documents  Document[]
  monitoring Monitoring[]

  @@index([tenderNumber])
  @@index([status])
  @@index([projectId])
}


// =========================================================
// PHASE 3: TEC & CONTRACT
// =========================================================

model Tec {
  id             String    @id @default(uuid())
  tecReference   String    @unique
  committeeName  String
  formationDate  DateTime?
  orderNumber    String?
  description    String?
  evalStartDate  DateTime?
  evalEndDate    DateTime?

  status         String    @default("Draft")
  recommendation String?
  remarks        String?
  deletedAt      DateTime?

  projectId String?
  project   Project? @relation(
    fields: [projectId],
    references: [id]
  )

  tenderId String
  tender   Tender @relation(
    fields: [tenderId],
    references: [id]
  )

  createdById String?
  createdBy   User? @relation(
    "TecCreatedBy",
    fields: [createdById],
    references: [id]
  )

  updatedById String?
  updatedBy   User? @relation(
    "TecUpdatedBy",
    fields: [updatedById],
    references: [id]
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   TecMember[]
  documents Document[]

  @@index([tecReference])
  @@index([status])
  @@index([tenderId])
}

model TecMember {
  id          String   @id @default(uuid())
  name        String
  designation String?
  department  String?
  role        String?
  remarks     String?

  tecId String
  tec   Tec @relation(
    fields: [tecId],
    references: [id]
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tecId])
}

model Contract {
  id                 String   @id @default(uuid())
  contractNumber     String   @unique
  contractTitle      String
  contractType       String?
  contractorName     String
  contractorIdNumber String?
  contractorAddress  String?

  contractAmount      Float?
  performanceSecurity Float?
  paymentTerms        String?
  fundingSource       String?

  awardDate     DateTime?
  agreementDate DateTime?
  startDate     DateTime?
  endDate       DateTime?

  contractDuration String?

  status    String    @default("Draft")
  deletedAt DateTime?

  projectId String?
  project   Project? @relation(
    fields: [projectId],
    references: [id]
  )

  tenderId String
  tender   Tender @relation(
    fields: [tenderId],
    references: [id]
  )

  createdById String?
  createdBy   User? @relation(
    "ContractCreatedBy",
    fields: [createdById],
    references: [id]
  )

  updatedById String?
  updatedBy   User? @relation(
    "ContractUpdatedBy",
    fields: [updatedById],
    references: [id]
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents  Document[]
  monitoring Monitoring[]

  @@index([contractNumber])
  @@index([status])
  @@index([tenderId])
}


// =========================================================
// PHASE 4: DOCUMENT MANAGEMENT
// =========================================================

model Document {
  id            String  @id @default(uuid())
  title         String
  fileName      String
  fileExtension String?
  mimeType      String?
  fileSize      Int?
  storageKey    String?
  category      String?
  documentType  String?
  description   String?

  status        String @default("Active")
  versionNumber Int    @default(1)

  projectId String?
  project   Project? @relation(
    fields: [projectId],
    references: [id]
  )

  tenderId String?
  tender   Tender? @relation(
    fields: [tenderId],
    references: [id]
  )

  tecId String?
  tec   Tec? @relation(
    fields: [tecId],
    references: [id]
  )

  contractId String?
  contract   Contract? @relation(
    fields: [contractId],
    references: [id]
  )

  monitoringId String?
  monitoring   Monitoring? @relation(
    fields: [monitoringId],
    references: [id]
  )

  versions DocumentVersion[]

  deletedAt DateTime?

  createdById String?
  createdBy   User? @relation(
    "DocumentCreatedBy",
    fields: [createdById],
    references: [id]
  )

  updatedById String?
  updatedBy   User? @relation(
    "DocumentUpdatedBy",
    fields: [updatedById],
    references: [id]
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([tenderId])
  @@index([tecId])
  @@index([contractId])
  @@index([monitoringId])
  @@index([category])
  @@index([documentType])
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(
    fields: [documentId],
    references: [id]
  )

  versionNumber Int
  fileName      String
  fileSize      Int?
  mimeType      String?
  storageKey    String
  notes         String?

  createdById String?
  createdBy   User? @relation(
    "DocVersionCreatedBy",
    fields: [createdById],
    references: [id]
  )

  createdAt DateTime @default(now())

  @@index([documentId])
}


// =========================================================
// PHASE 5: MONITORING
// =========================================================

model Monitoring {
  id              String   @id @default(uuid())
  referenceNumber String   @unique

  projectId String
  project   Project @relation(
    fields: [projectId],
    references: [id]
  )

  tenderId String?
  tender   Tender? @relation(
    fields: [tenderId],
    references: [id]
  )

  contractId String?
  contract   Contract? @relation(
    fields: [contractId],
    references: [id]
  )

  monitoringType String
  monitoringDate DateTime

  startTime String?
  endTime   String?

  officer     String?
  team        String?
  location    String?
  purpose     String?
  description String?

  status String @default("Scheduled")

  overallObservation String?
  overallStatus      String?
  recommendationsSum String?
  remarks            String?

  documents       Document[]
  videoLinks      VideoLink[]
  observations    Observation[]
  issues          Issue[]
  recommendations Recommendation[]
  actions         FollowUpAction[]

  deletedAt DateTime?

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([tenderId])
  @@index([contractId])
  @@index([status])
}

model VideoLink {
  id           String     @id @default(uuid())
  monitoringId String
  monitoring   Monitoring @relation(
    fields: [monitoringId],
    references: [id]
  )

  title       String
  platform    String
  url         String
  sessionDate DateTime?
  startTime   String?
  endTime     String?
  description String?

  status String @default("Active")

  createdById String?
  createdAt   DateTime @default(now())

  @@index([monitoringId])
}

model Observation {
  id           String     @id @default(uuid())
  monitoringId String
  monitoring   Monitoring @relation(
    fields: [monitoringId],
    references: [id]
  )

  category        String?
  description     String
  severity        String?
  observationDate DateTime?
  recordedBy      String?
  remarks         String?
  status          String @default("Open")

  createdAt DateTime @default(now())

  @@index([monitoringId])
}

model Issue {
  id                String     @id @default(uuid())
  monitoringId      String
  monitoring        Monitoring @relation(
    fields: [monitoringId],
    references: [id]
  )

  issueNumber       String
  description       String
  category          String?
  severity          String?
  dateIdentified    DateTime?
  responsiblePerson String?
  targetDate        DateTime?
  status            String     @default("Open")
  resolutionDate    DateTime?
  resolutionRemarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([monitoringId])
}

model Recommendation {
  id                 String     @id @default(uuid())
  monitoringId       String
  monitoring         Monitoring @relation(
    fields: [monitoringId],
    references: [id]
  )

  recommendationText String
  priority            String?
  responsiblePerson   String?
  targetDate          DateTime?
  status              String @default("Pending")
  remarks             String?

  createdAt DateTime @default(now())

  @@index([monitoringId])
}

model FollowUpAction {
  id                 String     @id @default(uuid())
  monitoringId       String
  monitoring         Monitoring @relation(
    fields: [monitoringId],
    references: [id]
  )

  actionNumber       String
  description        String
  assignedTo         String?
  assignedDepartment String?
  dueDate            DateTime?
  priority           String?
  status             String @default("Pending")
  completionDate     DateTime?
  completionRemarks  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([monitoringId])
}
